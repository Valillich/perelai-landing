NEXT_PUBLIC_APP_URL=https://perelai.app
NEXT_PUBLIC_BOOKING_URL=https://book.perelai.app
NEXT_PUBLIC_LANDING_URL=https://perelai.com
# PostHog remains disabled in Launch v1 code even if a key is configured.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# LP2 drift guard (path to the app repo; optional):
# PERELAI_APP_REPO=../beauty-finance
# Enables ONLY the isolated /legal-preview/* surface for draft deployments:
# unapproved documents render there (always noindex). Canonical /legal/*
# routes stay fail-closed regardless of this flag — production deployments
# must leave it unset.
# LEGAL_DRAFT_PREVIEW=true
