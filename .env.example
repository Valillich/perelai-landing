NEXT_PUBLIC_APP_URL=https://perelai.app
NEXT_PUBLIC_BOOKING_URL=https://book.perelai.app
NEXT_PUBLIC_LANDING_URL=https://perelai.com
# Calendar copy only: false/unset keeps the testing notice visible.
# Set true after OAuth/CS5 and general production rollout, then rebuild the landing.
# Does not enable the Calendar integration in the app.
NEXT_PUBLIC_GOOGLE_CALENDAR_RELEASED=false
# Optional Beta badge in app previews; defaults to true when unset.
# Independent of Calendar and paid-subscription publication flags.
# NEXT_PUBLIC_PRODUCT_STAGE_ENABLED=true
# Set to true only after live paid checkout is verified; rebuild the static landing.
# Until then Pricing and machine-readable pages show a checkout-unavailable notice.
# NEXT_PUBLIC_PAID_SUBSCRIPTIONS_LIVE=true
# Plan-specific STUDIO signup also requires accepted TEAM-RELEASE evidence.
# NEXT_PUBLIC_TEAM_RELEASED=true
# PostHog remains disabled in Launch v1 code even if a key is configured.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# LP2 drift guard (path to the app repo; optional):
# PERELAI_APP_REPO=../beauty-finance
# Enables ONLY the isolated /legal-preview/* surface for draft deployments:
# unapproved documents render there (always noindex). Canonical /legal/*
# routes stay fail-closed regardless of this flag — production deployments
# must leave it unset.
# LEGAL_DRAFT_PREVIEW=true
# Platform release: all seven documents are 2026-11-01.2, effective 2026-11-01.
# Dates/versions are loaded from content/legal/en/*.md and versions.json; the
# landing has no ENV override for them. Do not add a second effective-date switch.
# Matching app API LEGAL_{TERMS,DPA,PRIVACY,BOOKING_TERMS}_VERSION and Web
# VITE_LEGAL_{TERMS,DPA,PRIVACY,BOOKING_TERMS,BILLING}_VERSION: 2026-11-01.2.
# Deploy matching pages and app versions together for the postponed launch;
# signup/booking acceptance-copy versions are separate. Do not rewrite prior evidence.
# Public operator identity for /legal/* (required at build time in production).
# Must equal lib/legal/production-identity.ts exactly: the approved document
# hashes in content/legal/versions.json were computed against these values.
NEXT_PUBLIC_LEGAL_PROVIDER_FULL_NAME="Valerii Illichov (ІЛЛІЧОВ ВАЛЕРІЙ ВАЛЕРІЙОВИЧ)"
NEXT_PUBLIC_LEGAL_PROVIDER_FORM="Individual Entrepreneur (FOP)"
NEXT_PUBLIC_LEGAL_TRADING_NAME="Perelai"
NEXT_PUBLIC_LEGAL_COUNTRY_OF_REGISTRATION="Ukraine"
# EDR record number (24.04.2017); validated but not rendered in the documents.
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER="21010000000028235"
NEXT_PUBLIC_LEGAL_TAX_NUMBER="3278516853"
NEXT_PUBLIC_LEGAL_BUSINESS_ADDRESS="Zamarstynivska 170E, apartment 68, Lviv, 79068, Ukraine"
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL="support@perelai.app"
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL="support@perelai.app"
NEXT_PUBLIC_LEGAL_NOTICES_EMAIL="support@perelai.app"
NEXT_PUBLIC_LEGAL_SECURITY_EMAIL="support@perelai.app"
